<%- include('../partials/header', { title }) %>

<div class="page-title-row">
  <div>
    <h1>请求日志</h1>
    <p class="muted">共查询到 <%= total %> 条记录。</p>
  </div>
  <a class="btn" href="/security-audit/export?<%= new URLSearchParams(query).toString() %>">导出 CSV</a>
</div>

<section class="card">
  <form class="filter-form" method="get" action="/security-audit/logs">
    <input name="ip" placeholder="IP 地址" value="<%= query.ip || '' %>">
    <input name="path" placeholder="请求路径" value="<%= query.path || '' %>">
    <select name="method">
      <option value="">全部方法</option>
      <% ['GET','POST','PUT','PATCH','DELETE'].forEach(m => { %>
        <option value="<%= m %>" <%= query.method === m ? 'selected' : '' %>><%= m %></option>
      <% }) %>
    </select>
    <select name="riskLevel">
      <option value="">全部风险等级</option>
      <% ['normal','low','medium','high'].forEach(level => { %>
        <option value="<%= level %>" <%= query.riskLevel === level ? 'selected' : '' %>><%= level %></option>
      <% }) %>
    </select>
    <input type="date" name="startDate" value="<%= query.startDate || '' %>">
    <input type="date" name="endDate" value="<%= query.endDate || '' %>">
    <button class="btn primary" type="submit">筛选</button>
    <a class="btn" href="/security-audit/logs">重置</a>
  </form>
</section>

<section class="card table-card">
  <table>
    <thead>
      <tr>
        <th>时间</th>
        <th>IP</th>
        <th>方法</th>
        <th>路径</th>
        <th>状态码</th>
        <th>耗时</th>
        <th>风险等级</th>
        <th>风险类型</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% if (logs.length === 0) { %>
        <tr><td colspan="9" class="empty">暂无日志</td></tr>
      <% } %>
      <% logs.forEach(log => { %>
        <tr>
          <td><%= new Date(log.createdAt).toLocaleString('zh-CN') %></td>
          <td><%= log.ip %></td>
          <td><span class="tag"><%= log.method %></span></td>
          <td class="path-cell"><%= log.path %></td>
          <td><%= log.statusCode %></td>
          <td><%= log.responseTime %> ms</td>
          <td><span class="risk <%= log.riskLevel %>"><%= log.riskLevel %></span></td>
          <td><%= (log.riskTypes || []).join(', ') || '-' %></td>
          <td><a class="link" href="/security-audit/detail/<%= log._id %>">详情</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>

<div class="pagination">
  <% const baseQuery = new URLSearchParams(query); baseQuery.delete('page'); %>
  <% if (page > 1) { %>
    <a class="btn" href="?page=<%= page - 1 %>&<%= baseQuery.toString() %>">上一页</a>
  <% } %>
  <span>第 <%= page %> / <%= totalPages %> 页</span>
  <% if (page < totalPages) { %>
    <a class="btn" href="?page=<%= page + 1 %>&<%= baseQuery.toString() %>">下一页</a>
  <% } %>
</div>

<%- include('../partials/footer') %>
